# Postgres. postgres://... for Tiger Data or local Postgres (H1).
# pglite://./.pgdata (embedded, on disk) or pglite://memory for zero-install local dev/tests.
DATABASE_URL=pglite://./.pgdata
NESSIE_API_KEY=                                          # H2
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
NESSIE_SOURCE=file                                       # file | api  (file reads seed/generated/nessie.json)
META_API_KEY=                                            # Meta Model API key (developer.meta.com); needed for LLM_MODE=live
META_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3-contributor                     # contributor = cheaper, Meta trains on prompts; muse-spark-1.3 = standard
LLM_REASONING=low                                        # default | minimal | low | medium | high | xhigh  ("default" = model's own level)
LLM_CONCURRENCY=4                                        # max parallel live LLM calls per pipeline stage
GEMINI_API_KEY=                                          # embeddings only (EMBED_MODE=live); Meta's Model API has no embedding model
GEMINI_EMBED_MODEL=gemini-embedding-001                # confirm in H3 (768-dim output)
EMBED_MODE=local                                         # local | live  (local = offline hashing stand-in; live = Gemini embeddings)
LLM_MODE=replay                                          # live | replay  (replay = cache/fixtures only, error on miss)
MESSAGES_DIR=./seed/generated/instagram                  # folder shaped like an IG export
CALENDAR_FILE=./seed/generated/calendar.json
NESSIE_FILE=./seed/generated/nessie.json
PORT=3000
# --- LangSmith tracing: OFF by default. PRIVACY: when on, prompt text (incl. message contents) and model outputs are sent to LangSmith.
# LANGSMITH_TRACING=true                                 # tracing is active only if this is "true" AND LANGSMITH_API_KEY is set
# LANGSMITH_API_KEY=                                     # from smith.langchain.com -> Settings -> API keys
# LANGSMITH_PROJECT=sark-hack-tx                         # project name traces appear under (default: "default")
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com     # use https://eu.api.smith.langchain.com for the EU region
# LANGSMITH_HIDE_INPUTS=false                            # true = send run structure/timing/tokens but not inputs
# LANGSMITH_HIDE_OUTPUTS=false                           # true = same for outputs
# EXPO_PUBLIC_API_URL=http://localhost:3000              # optional; app defaults to the Expo dev host on :3000
